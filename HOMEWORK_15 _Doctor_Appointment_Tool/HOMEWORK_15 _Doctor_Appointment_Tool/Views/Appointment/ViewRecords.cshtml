@model List<HOMEWORK_15__Doctor_Appointment_Tool.Models.Appointment>
<div class="container">
<table>
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Doctor</th>
            <th>Time</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var appointment in Model)
        {
            <tr>
                <td>@appointment.Patient.FirstName</td>
                <td>@appointment.Patient.LastName</td>
                <td>@appointment.Doctor.Type</td>
                <td>@appointment.Time</td>
            </tr>
        }
    </tbody>
</table>
    <a href="/Appointment/Book" class="btn-back">Go Back</a>
</div>
